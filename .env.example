# Backblaze B2 凭证（必填）
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# Endpoint 与 Region（至少配置一个）：
# - 设置 B2_ENDPOINT 时优先使用它，支持任意 S3 兼容 endpoint；
#   无法从主机名推断 region 时自动使用 us-east-1，也可用 B2_REGION 显式指定。
# - 只设置 B2_REGION 时，自动使用 https://s3.<region>.backblazeb2.com
B2_ENDPOINT=
B2_REGION=

# 表单「前缀」输入框的默认值（可空，例如 backups/2026）
# 仅作为录入/上传表单的预填值，用户可临时覆盖。（旧名 B2_PREFIX 仍向后兼容）
DEFAULT_PREFIX=

# 上传对象 key 的固定前缀，所有上传文件都会自动拼接（默认：files/）
# 留空则不加固定前缀；设为 files/ 后对象 key 形如 files/<prefix>/<UUID>.ext
# 与 DEFAULT_PREFIX 的区别：此项是全局固定的应用隔离层，不在表单中暴露、不可临时覆盖
BUCKET_PREFIX=

# 服务器文件根目录：服务器文件列表与服务器上传/下载都限定在该目录内
SERVER_FILE_ROOT=

# 页面访问密钥：所有请求需带 ?apikey=<值>
APP_API_KEY=

# 服务监听地址与端口（默认仅本机访问）
HOST=127.0.0.1
PORT=5000

# ── 北京桶（可选，全部留空则不启用）──
BEIJING_APPLICATION_KEY_ID=
BEIJING_APPLICATION_KEY=
BEIJING_BUCKET=kkk-oo-a
BEIJING_ENDPOINT=tos-s3-cn-beijing.volces.com
BEIJING_REGION=cn-beijing
