# Backblaze B2 凭证（必填）
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# Endpoint 与 Region（至少配置一个）：
# - 设置 B2_ENDPOINT 时优先使用它，支持任意 S3 兼容 endpoint；
#   无法从主机名推断 region 时自动使用 us-east-1，也可用 B2_REGION 显式指定。
# - 只设置 B2_REGION 时，自动使用 https://s3.<region>.backblazeb2.com
B2_ENDPOINT=
B2_REGION=

# 文件列表默认前缀（可空，例如 backups/2026）
B2_PREFIX=

# 页面访问密钥：所有请求需带 ?apikey=<值>
APP_API_KEY=

# 服务监听地址与端口（默认仅本机访问）
HOST=127.0.0.1
PORT=5000
